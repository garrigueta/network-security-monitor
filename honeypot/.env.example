# Honeypot environment variables
# Copy to .env and configure

# Loki instance on main monitoring server (RPi1)
LOKI_URL=http://192.168.1.100:3100

# Network configuration
HONEYPOT_NETWORK=192.168.1.0/24

# External ports (if using port forwarding)
# SSH Honeypot external port
COWRIE_SSH_PORT=22
# Telnet Honeypot external port  
COWRIE_TELNET_PORT=23
