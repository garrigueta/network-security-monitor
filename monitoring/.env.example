# Docker Compose environment variables
# Copy this file to .env and customize

# Network Configuration
# eth0: Regular switch port (management/internet access)
# eth1: Mirrored traffic port from switch (monitoring interface)
ZEEK_INTERFACE=eth1

# Storage Configuration
# SSD mount point for logs and data
SSD_MOUNT_PATH=/mnt/ssd-logs

# Grafana Configuration
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Data Retention (adjust based on SSD capacity)
LOKI_RETENTION_PERIOD=720h  # 30 days (increased for SSD)
PROMETHEUS_RETENTION=30d    # 30 days (increased for SSD)

# Resource Limits for Pi5 (8GB RAM recommended)
ZEEK_MEM_LIMIT=3g
PROMETHEUS_MEM_LIMIT=2g
LOKI_MEM_LIMIT=1g
GRAFANA_MEM_LIMIT=512m
